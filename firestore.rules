rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Verified legal aid clinics and statutory rights benchmarks: Publicly readable
    match /legalAidDirectory/{clinicId} {
      allow read: if true;
      allow write: if false; // Only updated via admin migration scripts
    }
    
    match /statutoryBenchmarks/{statuteId} {
      allow read: if true;
      allow write: if false;
    }
    
    // User legal analysis sessions: strictly scoped
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Audit logs (anonymized telemetries): Write-only by server, no public read
    match /auditLogs/{logId} {
      allow read: if false;
      allow write: if false; // Handled exclusively via Firebase Admin SDK
    }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
