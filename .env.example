# JurisAccess AI Environment Configuration (Render Web Service)
NODE_ENV=production
PORT=10000

# Google Gemini API Key (Optional in MOCK mode for local testing & CI)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Mode: 'gemini' for live AI or 'mock' for deterministic automated testing and standalone evaluation
LLM_PROVIDER=gemini
LLM_TIMEOUT_MS=8000
LLM_CIRCUIT_BREAKER_MS=60000

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Comma-free, exact browser origin allowed to call this API. Set this to the
# deployed frontend URL in production (for example, https://your-app.vercel.app).
CORS_ORIGIN=http://localhost:5173
