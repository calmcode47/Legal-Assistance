# JurisAccess AI Environment Configuration
NODE_ENV=development
PORT=8080

# Google Gemini API Key (Optional in MOCK_MODE for local testing & CI)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Mode: Set to 'mock' for deterministic automated testing and standalone evaluation, or 'gemini' for live AI
LLM_PROVIDER=mock

# Firebase Project Configuration
FIREBASE_PROJECT_ID=jurisaccess-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@jurisaccess-ai.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
CORS_ORIGIN=*
